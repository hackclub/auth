<%= render Components::PublicActivity::Snippet.new(activity) do %>
  <% if activity.parameters["reason"] == "expired" %>
    membership expired: <%= activity.parameters["member_type"] || "member" %> <b><%= (respond_to?(:activity_member_name) ? activity_member_name(activity) : Directory::ActivityPeople.member_name(activity)) || "(unknown)" %></b> from <b><%= activity.trackable&.name || activity.parameters["name"] || "(deleted)" %></b>.
  <% else %>
    removed <%= activity.parameters["member_type"] || "member" %> <b><%= (respond_to?(:activity_member_name) ? activity_member_name(activity) : Directory::ActivityPeople.member_name(activity)) || "(unknown)" %></b> from <b><%= activity.trackable&.name || activity.parameters["name"] || "(deleted)" %></b>.
  <% end %>
<% end %>

<%= render Components::PublicActivity::Snippet.new(activity) do %>
  added <%= activity.parameters["member_type"] || "member" %> <b><%= (respond_to?(:activity_member_name) ? activity_member_name(activity) : activity.parameters["member_name"]) || "(unknown)" %></b> to <b><%= activity.trackable&.name || activity.parameters["name"] || "(deleted)" %></b>.
<% end %>

<!DOCTYPE html>
<html data-webtui-theme="gruvbox-dark-hard">
  <head>
    <title><%= [content_for(:title).presence, t("directory.layout.page_title")].compact.join(" — ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "backend-next.css" %>
    <%= vite_javascript_tag 'backend' %>
  </head>
  <body>
    <row id="hca-actionbar" align-="center between">
      <row gap-="1" align-="center">
        <a href="<%= directory_root_path %>" style="text-decoration: none; color: var(--foreground0);" title="hacktive directory users and computers"><b><%= t("directory.layout.title") %></b></a>
        <% breadcrumbs.drop(1).each do |crumb| %>
          <span style="color: var(--foreground2);">/</span>
          <% if crumb[:path] %>
            <a href="<%= crumb[:path] %>" style="color: var(--foreground2); text-decoration: none;"><%= crumb[:label] %></a>
          <% else %>
            <span style="color: var(--foreground0);"><%= crumb[:label] %></span>
          <% end %>
        <% end %>
      </row>
      <row gap-="2" align-="center">
        <span id="theme-toggle-slot"></span>
        <span style="color: var(--foreground2);"><%= current_identity.first_name %> <%= current_identity.last_name %></span>
        <% if directory_admin? %>
          <span is-="badge" variant-="yellow"><%= t("directory.layout.admin") %></span>
        <% end %>
      </row>
    </row>
    <nav class="dir-nav">
      <a href="<%= directory_root_path %>" class="<%= 'active' if controller_name == 'collections' && action_name == 'index' %>">collections</a>
      <a href="<%= directory_my_access_path %>" class="<%= 'active' if controller_name == 'my_access' %>">my access</a>
      <% if directory_admin? %>
        <a href="<%= directory_people_path %>" class="<%= 'active' if controller_name == 'people' %>">people</a>
        <a href="<%= directory_all_grants_path %>" class="<%= 'active' if controller_name == 'grants' %>">grants</a>
        <a href="<%= directory_reports_path %>" class="<%= 'active' if controller_name == 'reports' %>">reports</a>
        <a href="<%= directory_activity_path %>" class="<%= 'active' if controller_name == 'activity' %>">activity</a>
        <a href="<%= directory_health_path %>" class="<%= 'active' if controller_name == 'health' %>">health</a>
        <span class="dir-nav-spacer"></span>
        <a href="<%= directory_new_import_path %>" class="<%= 'active' if controller_name == 'import' %>">import</a>
        <a href="<%= directory_search_path %>" class="<%= 'active' if controller_name == 'search' %>">search</a>
        <a href="<%= directory_view_as_path %>" class="<%= 'active' if controller_name == 'view_as' %>">view as</a>
      <% end %>
    </nav>
    <column id="hca-body" self-="grow">
      <% flash.each do |type, message| %>
        <div style="max-width: 120ch; margin: 0 auto; width: 100%; padding: 0.5lh 2ch 0 2ch;">
          <div class="tui-banner-<%= type %>" box-="square" style="padding: 0.25lh 1ch;"><%= message %></div>
        </div>
      <% end %>
      <%= yield %>
    </column>
    <script type="application/json" id="keyboard-shortcuts-data"><%= raw(directory_keyboard_shortcuts.to_json) %></script>
    <script type="application/json" id="kbar-data"><%= raw(directory_kbar_data.to_json) %></script>
  </body>
</html>
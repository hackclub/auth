<% content_for :title, "Case #{@case.public_id}" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;" gap-="1">
  <row align-="center between">
    <h2><%= @case.public_id %></h2>
    <row gap-="1" align-="center">
      <span is-="badge" variant-="<%= @case.approved? ? 'green' : @case.denied? ? 'red' : @case.withdrawn? ? 'background2' : 'yellow' %>"><%= @case.status.humanize.downcase %></span>
      <% if @case.document_class.present? %><span is-="badge" variant-="background2"><%= @case.document_class.humanize.downcase %></span><% end %>
      <% if @case.skip_persona? %><span is-="badge" variant-="background2">no persona</span><% end %>
    </row>
  </row>

  <row gap-="2">
    <span>identity: <a href="<%= backend_identity_path(@case.identity) %>"><%= @case.identity.first_name %> <%= @case.identity.last_name %></a> (<%= @case.identity.public_id %>)</span>
    <span style="color: var(--foreground2);">opened <%= time_ago_in_words(@case.created_at) %> ago<% if @case.opened_by %> by <%= @case.opened_by.identity&.first_name || "staff" %><% end %></span>
  </row>

  <% if @case.alternative? && @case.alternative_reason.present? %>
    <row gap-="1">
      <span style="color: var(--foreground2);">no-gov-ID reason:</span>
      <span><%= VerificationCase::ALTERNATIVE_REASONS[@case.alternative_reason] %><% if @case.alternative_reason_details.present? %> — <%= @case.alternative_reason_details %><% end %></span>
    </row>
  <% end %>

  <% if @case.submitted_fields.present? %>
    <div is-="separator"></div>
    <span style="color: var(--foreground2); font-style: italic;">submitted fields</span>
    <table>
      <tbody>
        <% @case.submitted_fields.each do |field, value| %>
          <tr><td style="color: var(--foreground2);"><%= field.humanize %></td><td><%= value %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div is-="separator"></div>
  <span style="color: var(--foreground2); font-style: italic;">documents (raw evidence — access is logged)</span>
  <% if @documents.any? %>
    <column gap-="2">
      <% @documents.each_with_index do |doc, index| %>
        <column gap-="1">
          <row align-="center between">
            <b><%= index + 1 %>. <%= doc.kind_label %></b>
            <row gap-="1" align-="center" style="color: var(--foreground2);">
              <span><%= doc.source %></span>
              <span>·</span>
              <span><%= doc.created_at.strftime("%b %-d, %Y") %></span>
            </row>
          </row>
          <% if doc.file.attached? %>
            <% if glass_broken?(doc, auto_break_glass: @case.auto_break_glass_reason) %>
              <% file = doc.file %>
              <% if file.content_type.start_with?("image/") %>
                <%
                  image_src = if file.content_type.in?(%w[image/heic image/heif])
                    url_for(file.variant(format: :png))
                  else
                    url_for(file)
                  end
                %>
                <div id="case-loader-<%= index %>" style="color: var(--foreground2); padding: 1lh 0;">
                  <%= file.content_type.in?(%w[image/heic image/heif]) ? "converting heic..." : "loading..." %>
                </div>
                <div id="case-image-container-<%= index %>" style="display: none;">
                  <%= image_tag image_src,
                    alt: "case document #{index + 1}",
                    id: "case-image-#{index}",
                    style: "max-width: 100%; transition: transform 0.2s;",
                    data: { rotation: 0 },
                    onload: "document.getElementById('case-loader-#{index}').style.display='none'; document.getElementById('case-image-container-#{index}').style.display='block';",
                    onerror: "document.getElementById('case-loader-#{index}').textContent='error loading image';" %>
                  <row gap-="1" align-="center">
                    <button type="button" size-="small" onclick="rotateCaseImage(<%= index %>)">↻ rotate</button>
                    <%= link_to "open ↗", url_for(file), target: "_blank" %>
                  </row>
                </div>
              <% elsif file.content_type == "application/pdf" %>
                <iframe src="<%= url_for(file) %>" style="width: 100%; height: 60vh; border: 1px solid var(--background2);" type="application/pdf">
                  <span style="color: var(--foreground2);">
                    browser doesn't support pdf embedding.
                    <%= link_to "open pdf", url_for(file), target: "_blank" %>
                  </span>
                </iframe>
              <% else %>
                <%= link_to "download file", url_for(file), target: "_blank" %>
              <% end %>
            <% else %>
              <%= form_with url: backend_break_glass_path, method: :post, local: true, style: "display:inline" do %>
                <input type="hidden" name="break_glassable_type" value="VerificationCase::Document">
                <input type="hidden" name="break_glassable_id" value="<%= doc.id %>">
                <input type="text" name="reason" placeholder="reason for access" required style="width: 20ch;">
                <button type="submit" is-="button" size-="small">break glass</button>
              <% end %>
            <% end %>
          <% end %>
        </column>
      <% end %>
    </column>
    <script>
      function rotateCaseImage(index) {
        const img = document.getElementById('case-image-' + index);
        let currentRotation = parseInt(img.dataset.rotation || 0);
        currentRotation = (currentRotation + 90);
        img.dataset.rotation = currentRotation;
        img.style.transform = 'rotate(' + currentRotation + 'deg)';
      }
    </script>
  <% else %>
    <span style="color: var(--foreground2);">nothing submitted yet</span>
  <% end %>

  <% if @case.persona_signal_snapshot.present? %>
    <details>
      <summary style="color: var(--foreground2);">persona signal snapshot</summary>
      <pre style="overflow-x: auto;"><%= JSON.pretty_generate(@case.persona_signal_snapshot) %></pre>
    </details>
  <% end %>

  <% if @case.call_starts_at.present? %>
    <div is-="separator"></div>
    <row gap-="1">
      <span style="color: var(--foreground2);">call:</span>
      <span><%= @case.call_starts_at.strftime("%Y-%m-%d %H:%M %Z") %> (booking <%= @case.booking_uid %>)</span>
    </row>
  <% end %>

  <%# === actions === %>
  <% if @case.open? %>
    <%# the row only renders when a button applies — otherwise it's a stray gap %>
    <% if @case.link_sent? || @case.requested? || @case.call_scheduled? %>
      <div is-="separator"></div>
      <row gap-="2" align-="center">
        <% if @case.link_sent? || @case.requested? %>
          <%= form_with url: resend_link_backend_verification_case_path(@case), method: :post, local: true do %>
            <button type="submit" is-="button" size-="small">resend link</button>
          <% end %>
        <% end %>
        <% if @case.call_scheduled? %>
          <%= form_with url: hold_call_backend_verification_case_path(@case), method: :patch, local: true, multipart: true do %>
            <row gap-="1" align-="center">
              <input type="file" name="screenshot" accept="image/jpeg,image/png" required>
              <button type="submit" is-="button" size-="small">mark call held</button>
            </row>
            <span style="color: var(--foreground2);"><small>one screenshot showing the user and their document</small></span>
          <% end %>
        <% end %>
      </row>
    <% end %>

    <% if @case.docs_submitted? %>
      <div is-="separator"></div>
      <%= form_with url: request_redo_backend_verification_case_path(@case), method: :post, local: true do %>
        <row gap-="1" align-="center">
          <textarea name="message" rows="2" placeholder="what should the user redo? this goes in the email" required style="flex: 1;"></textarea>
          <button type="submit" is-="button" size-="small">request redo</button>
        </row>
      <% end %>
    <% end %>

    <% if @case.call_held? %>
      <div is-="separator"></div>
      <span style="color: var(--foreground2); font-style: italic;">decision</span>

      <%= form_with url: decide_backend_verification_case_path(@case), method: :patch, local: true do %>
        <column gap-="1">
          <table>
            <tbody>
              <% Verification::ManualVerificationCall::CHECKLIST_ITEMS.each do |key, label| %>
                <%# no selfie on the case → nothing to compare against %>
                <% next if key == "doc_matches_selfie" && !@case.selfie_available? %>
                <tr>
                  <td><%= label %></td>
                  <td>
                    <label><input type="radio" name="checklist[<%= key %>]" value="yes" required> yes</label>
                    <label><input type="radio" name="checklist[<%= key %>]" value="no"> no</label>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>

          <row gap-="2" align-="center">
            <label>confidence:
              <select name="confidence" required>
                <% Verification::ManualVerificationCall::CONFIDENCE_LEVELS.each do |level| %>
                  <option value="<%= level %>"><%= level %></option>
                <% end %>
              </select>
            </label>
          </row>

          <textarea name="notes" placeholder="free-text notes from the call" rows="3"></textarea>

          <row gap-="2" align-="center">
            <button type="submit" name="decision" value="approve" is-="button" variant-="green">approve</button>
            <span style="color: var(--foreground2);">deny with reason:</span>
            <select name="rejection_reason">
              <option value="">—</option>
              <% Verification::ManualVerificationCall::REJECTION_REASON_NAMES.each do |value, name| %>
                <option value="<%= value %>"><%= name %></option>
              <% end %>
            </select>
            <input type="text" name="rejection_reason_details" placeholder="details">
            <button type="submit" name="decision" value="deny" is-="button" variant-="red">deny</button>
          </row>
        </column>
      <% end %>

    <% end %>

    <div is-="separator"></div>
    <%= form_with url: withdraw_backend_verification_case_path(@case), method: :post, local: true,
        data: { confirm: "withdraw this case? the user's link stops working and no decision is recorded." } do %>
      <row gap-="1" align-="center">
        <span style="color: var(--foreground2);">close without a decision:</span>
        <input type="text" name="reason" placeholder="reason (optional)" style="flex: 1;">
        <button type="submit" is-="button" size-="small" variant-="red">withdraw</button>
      </row>
    <% end %>
  <% end %>

  <% if @case.verification.present? %>
    <div is-="separator"></div>
    <row gap-="1">
      <span style="color: var(--foreground2);">decision record:</span>
      <a href="<%= backend_verification_path(@case.verification) %>"><%= @case.verification.public_id %></a>
      <span is-="badge" variant-="<%= @case.verification.approved? ? 'green' : 'red' %>"><%= @case.verification.status %></span>
    </row>

    <%# === qa sample === %>
    <% verification = @case.verification %>
    <% if verification.respond_to?(:sampled?) %>
      <row gap-="1" align-="center">
        <span style="color: var(--foreground2);">qa sample:</span>
        <% if verification.sampled? %>
          <span is-="badge" variant-="<%= verification.sample_verdict == 'agree' ? 'green' : 'red' %>"><%= verification.sample_verdict %></span>
          <span style="color: var(--foreground2);">by <%= verification.sample_reviewer&.identity&.first_name || "staff" %> · <%= verification.sampled_at.strftime("%b %-d, %Y") %></span>
        <% elsif verification.reviewer_id == current_user.id %>
          <span style="color: var(--foreground2);">your decision — someone else has to sample it</span>
          <% if verification.qa_candidate? %><span is-="badge" variant-="yellow">selected for qa</span><% end %>
        <% else %>
          <% if verification.qa_candidate? %><span is-="badge" variant-="yellow">selected for qa</span><% end %>
          <span style="color: var(--foreground2);">not sampled yet</span>
        <% end %>
      </row>
      <% if verification.sampled? && verification.sample_notes.present? %>
        <span style="white-space: pre-wrap; color: var(--foreground2);"><%= verification.sample_notes %></span>
      <% end %>
      <% if !verification.sampled? && verification.reviewer_id != current_user.id %>
        <%= form_with url: sample_backend_verification_case_path(@case), method: :post, local: true do %>
          <column gap-="1">
            <row gap-="2">
              <label><input type="radio" name="verdict" value="agree" required> agree with the decision</label>
              <label><input type="radio" name="verdict" value="disagree" required> disagree</label>
            </row>
            <row gap-="1" align-="center">
              <textarea name="notes" rows="2" placeholder="notes (required if you disagree)" style="flex: 1;"></textarea>
              <button type="submit" is-="button" size-="small">record sample</button>
            </row>
          </column>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%# === comments === %>
  <div is-="separator"></div>
  <span style="color: var(--foreground2); font-style: italic;">comments</span>
  <% if @comments.any? %>
    <column gap-="1">
      <% @comments.each do |comment| %>
        <column gap-="0">
          <row gap-="1">
            <b><%= comment.author.identity&.first_name || "staff" %></b>
            <span style="color: var(--foreground2);"><%= comment.created_at.strftime("%b %-d, %H:%M") %></span>
          </row>
          <span style="white-space: pre-wrap;"><%= comment.body %></span>
        </column>
      <% end %>
    </column>
  <% else %>
    <span style="color: var(--foreground2);">no comments yet</span>
  <% end %>
  <%= form_with url: comment_backend_verification_case_path(@case), method: :post, local: true do %>
    <row gap-="1" align-="center">
      <textarea name="body" rows="2" placeholder="leave a note for other reviewers" required style="flex: 1;"></textarea>
      <button type="submit" is-="button" size-="small">comment</button>
    </row>
  <% end %>

  <%# === audit trail === %>
  <div is-="separator"></div>
  <span style="color: var(--foreground2); font-style: italic;">audit trail (append-only)</span>
  <table>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td style="white-space: nowrap; color: var(--foreground2);"><%= event.created_at.strftime("%m-%d %H:%M") %></td>
          <td><b><%= event.key %></b></td>
          <td style="color: var(--foreground2);">
            <%= event.actor.is_a?(Backend::User) ? (event.actor.identity&.first_name || "staff") : event.actor.is_a?(Identity) ? "user" : "system" %>
          </td>
          <td style="color: var(--foreground2);"><%= event.data.present? ? event.data.to_json.truncate(120) : "" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</column>

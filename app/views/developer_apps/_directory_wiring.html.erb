<% exposures = Directory::Exposure.where(app_id: app.id).includes(:entitlement).index_by(&:entitlement_id) %>
<% requirements = Directory::AppRequirement.where(app_id: app.id).includes(:entitlement).index_by(&:entitlement_id) %>
<% has_groups_scope = app.has_scope?(:groups) %>
<% wired_ids = (exposures.keys + requirements.keys).uniq %>
<% wired = Directory::Collection.where(id: wired_ids).order(:name) %>

<% if exposures.any? && !has_groups_scope %>
  <p style="color: var(--pico-del-color); font-size: 0.85rem; margin-bottom: 0.5rem;">this app doesn't request the <code>groups</code> scope — wired entitlements won't appear in tokens until it does.</p>
<% end %>

<% wired.each do |ent| %>
  <% exp = exposures[ent.id] %>
  <% req = requirements[ent.id] %>
  <div class="collaborator-row">
    <span>
      <%= ent.name %>
      <% if exp && exp.claim_name != ent.slug %>
        <span style="color: var(--pico-muted-color); font-size: 0.85rem;">as</span>
        <code class="credential-value" style="font-size: 0.8rem;"><%= exp.claim_name %></code>
      <% end %>
      <% if req %>
        <span class="badge success" style="font-size: 0.65rem; margin-left: 0.4em; vertical-align: middle;">required</span>
      <% end %>
      <% if ent.description.present? && entitlement_visible?(ent, wiring_context) %>
        <br><span class="collaborator-email"><%= ent.description.truncate(80) %></span>
      <% end %>
    </span>

    <% if can_manage_app_wiring?(app, ent, wiring_context) %>
      <span class="inline-buttons" style="gap: 0.5rem;">
        <% if exp && !req %>
          <%= button_to "require", directory_app_requirements_path, method: :post, class: "secondary small-btn",
                params: { app_id: app.id, entitlement_slug: ent.slug, return_to: return_to } %>
        <% end %>
        <% if req %>
          <% confirm_key = requirements.size == 1 ? "remove_last_requirement_confirm" : "remove_requirement_confirm" %>
          <%= button_to "unrequire", directory_app_requirement_path(ent.slug, app_id: app.id), method: :delete, class: "secondary small-btn",
                params: { return_to: return_to },
                data: { confirm: t("directory.developer_apps.#{confirm_key}", name: ent.name) } %>
        <% end %>
        <% if exp %>
          <%= button_to "remove", directory_exposure_path(exp), method: :delete, class: "danger small-btn",
                params: { return_to: return_to },
                data: { confirm: t("directory.developer_apps.remove_exposure_confirm", claim: exp.claim_name) } %>
        <% end %>
      </span>
    <% end %>
  </div>
<% end %>

<% if wired.empty? %>
  <p style="color: var(--pico-muted-color);">no entitlements wired.</p>
<% end %>

<% if !app.hq_official? %>
  <p style="color: var(--pico-muted-color);"><%= t("directory.developer_apps.not_official") %></p>
<% elsif can_wire_any_entitlement?(app) %>
  <% entitlement_options = wireable_entitlements(app).map { |e| [e.name, e.slug] } %>

  <div class="add-collaborator" x-data="{ renamed: false }">
    <%= form_with url: directory_exposures_path, method: :post, local: true do |f| %>
      <%= f.hidden_field :app_id, value: app.id %>
      <%= hidden_field_tag :return_to, return_to %>
      <%= f.select :entitlement_slug, entitlement_options,
            { prompt: "add an entitlement…" }, required: true %>
      <template x-if="renamed">
        <span style="display: inline-flex; align-items: center; gap: 0.4em; margin: 0;">
          <span style="color: var(--pico-muted-color); font-size: 0.85rem;">as</span>
          <%= f.text_field :claim_name, placeholder: "name in your app", style: "max-width: 140px; margin: 0;" %>
        </span>
      </template>
      <label style="display: inline-flex; align-items: center; gap: 0.3em; white-space: nowrap; cursor: pointer; font-size: 0.85rem; color: var(--pico-muted-color);">
        <%= check_box_tag :also_require, "1", false, style: "width: auto; margin: 0;" %> require
      </label>
      <button type="submit" class="approve small-btn">add</button>
    <% end %>
    <a href="#" @click.prevent="renamed = !renamed" style="font-size: 0.8rem; color: var(--pico-muted-color); margin-top: 0.25rem; display: inline-block;"
       x-text="renamed ? 'use entitlement name' : 'rename'"></a>
  </div>
<% end %>

<% if directory_admin_session? %>
  <% revoker = app.directory_revoker %>
  <details style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--pico-card-border-color);">
    <summary style="cursor: pointer; color: var(--pico-muted-color); font-size: 0.9rem;">
      session revocation<% if revoker %> — <span class="badge <%= revoker.enabled ? 'success' : '' %>" style="font-size: 0.65rem;"><%= revoker.enabled ? revoker.adapter.tr("_", " ") : "disabled" %></span><% end %>
    </summary>
    <div style="margin-top: 0.75rem;">
      <%= render "developer_apps/session_revoker", app: app, revoker: revoker, return_to: return_to %>
    </div>
  </details>
<% end %>

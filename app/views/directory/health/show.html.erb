<% content_for :title, t("directory.health.show.title") %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2><%= t("directory.health.show.heading") %></h2><!-- this is dcdiag. hacktive directory users and computers. -->
    <row gap-="2" align-="center">
      <a href="<%= directory_root_path %>" style="color: var(--foreground2);"><%= t("directory.layout.title") %></a>
    </row>
  </row>

  <div is-="separator"></div>

  <% if @result %>
    <row gap-="2" align-="center">
      <% if @result.valid? %>
        <span is-="badge" variant-="green"><%= t("directory.health.show.valid") %></span>
      <% else %>
        <span is-="badge" variant-="red"><%= t("directory.health.show.invalid") %></span>
      <% end %>
      <% if @validated_at %>
        <span style="color: var(--foreground2);"><%= t("directory.health.show.last_run", time: time_ago_in_words(@validated_at)) %></span>
      <% end %>
    </row>

    <% unless @result.valid? %>
      <div is-="separator"></div>

      <span style="color: var(--foreground2); font-style: italic;"><%= t("directory.health.show.mismatches") %></span>

      <% @result.mismatches.each do |table_name, rows| %>
        <span style="color: var(--foreground2); font-style: italic;"><%= table_name %></span>

        <table>
          <thead>
            <tr>
              <th><%= t("directory.health.show.col_record") %></th>
              <th><%= t("directory.health.show.col_expected") %></th>
              <th><%= t("directory.health.show.col_actual") %></th>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |row| %>
              <tr>
                <td><%= row[:record] %></td>
                <td style="color: var(--green);"><%= row[:expected] %></td>
                <td style="color: var(--red);"><%= row[:actual] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>
  <% else %>
    <span style="color: var(--foreground2);"><%= t("directory.health.show.never_run") %></span>
  <% end %>

  <div is-="separator"></div>

  <%= form_with url: directory_health_validate_path, method: :post, local: true do |f| %>
    <button type="submit" size-="small"><%= t("directory.health.show.run_now") %></button>
  <% end %>

  <div is-="separator"></div>

  <span style="color: var(--foreground2); font-style: italic;"><%= t("directory.health.show.revokers") %></span>
  <% if @revokers.any? %>
    <table>
      <thead><tr><th><%= t("directory.health.show.col_app") %></th><th><%= t("directory.health.show.col_adapter") %></th><th><%= t("directory.health.show.col_enabled") %></th><th><%= t("directory.health.show.col_last_called") %></th><th><%= t("directory.health.show.col_result") %></th></tr></thead>
      <tbody>
        <% @revokers.each do |r| %>
          <tr>
            <td><%= r.app.name %></td>
            <td><code><%= r.adapter %></code></td>
            <td><%= r.enabled ? "✓" : "—" %></td>
            <td style="color: var(--foreground2);"><%= r.last_called_at&.strftime("%Y-%m-%d %H:%M") || "never" %></td>
            <td><%= r.last_result || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <span style="color: var(--foreground2);"><%= t("directory.health.show.no_revokers") %></span>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> <%= t("directory.layout.back") %>
    </row>
  </row>
</column>
<% content_for :title, "health" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>health</h2><!-- this is dcdiag. hacktive directory users and computers. -->
    <row gap-="2" align-="center">
      <a href="<%= directory_root_path %>" style="color: var(--foreground2);">directory</a>
    </row>
  </row>

  <div is-="separator"></div>

  <% if @result %>
    <row gap-="2" align-="center">
      <% if @result.valid? %>
        <span is-="badge" variant-="green">valid</span>
      <% else %>
        <span is-="badge" variant-="red">invalid</span>
      <% end %>
      <% if @validated_at %>
        <span style="color: var(--foreground2);">last run <%= time_ago_in_words(@validated_at) %> ago</span>
      <% end %>
    </row>

    <% unless @result.valid? %>
      <div is-="separator"></div>

      <span style="color: var(--foreground2); font-style: italic;">mismatches</span>

      <% @result.mismatches.each do |table_name, rows| %>
        <span style="color: var(--foreground2); font-style: italic;"><%= table_name %></span>

        <table>
          <thead>
            <tr>
              <th>record</th>
              <th>expected</th>
              <th>actual</th>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |row| %>
              <tr>
                <td><%= row[:record] %></td>
                <td style="color: var(--green);"><%= row[:expected] %></td>
                <td style="color: var(--red);"><%= row[:actual] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    <% end %>
  <% else %>
    <span style="color: var(--foreground2);">never run</span>
  <% end %>

  <div is-="separator"></div>

  <%= form_with url: directory_health_validate_path, method: :post, local: true do |f| %>
    <button type="submit" size-="small">run now</button>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> back
    </row>
  </row>
</column>

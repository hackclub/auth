<% content_for :title, t("directory.reports.index.title") %>
<column pad-="2 1" gap-="2" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2><%= t("directory.reports.index.heading") %></h2>
  </row>

  <%# Expiring soon — most actionable, shown first and open %>
  <% if @expiring_memberships.any? %>
    <details open>
      <summary style="cursor: pointer;"><b style="color: var(--foreground1);"><%= t("directory.reports.index.expiring_memberships") %></b> <span is-="badge" variant-="yellow"><%= @expiring_memberships.size %></span></summary>
      <table>
        <thead><tr><th><%= t("directory.reports.index.col_person") %></th><th><%= t("directory.reports.index.col_collection") %></th><th><%= t("directory.reports.index.col_expires") %></th></tr></thead>
        <tbody>
          <% @expiring_memberships.each do |m| %>
            <tr>
              <td><%= link_to m.member_person.full_name, directory_person_path(m.member_person) %></td>
              <td><%= link_to m.collection.name, directory_collection_path(m.collection.slug) %></td>
              <td style="color: var(--yellow);"><%= distance_of_time_in_words_to_now(m.expires_at) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </details>
    <div is-="separator"></div>
  <% end %>

  <%# Empty collections %>
  <details<%= " open" if @empty_collections.any? %>>
    <summary style="cursor: pointer;"><b style="color: var(--foreground1);"><%= t("directory.reports.index.empty_collections") %></b> <span is-="badge" variant-="background2"><%= @empty_collections.size %></span></summary>
    <% if @empty_collections.any? %>
      <table>
        <thead><tr><th><%= t("directory.reports.index.col_name") %></th><th><%= t("directory.reports.index.col_kind") %></th></tr></thead>
        <tbody>
          <% @empty_collections.each do |c| %>
            <tr>
              <td><%= link_to c.name, directory_collection_path(c.slug) %></td>
              <td><span is-="badge" variant-="<%= c.group? ? 'blue' : 'green' %>"><%= c.kind %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2); padding: 4px 0;"><%= t("directory.reports.index.none") %></span>
    <% end %>
  </details>

  <%# Unmanaged collections %>
  <details<%= " open" if @unmanaged_collections.any? %>>
    <summary style="cursor: pointer;"><b style="color: var(--foreground1);"><%= t("directory.reports.index.unmanaged_collections") %></b> <span is-="badge" variant-="background2"><%= @unmanaged_collections.size %></span></summary>
    <% if @unmanaged_collections.any? %>
      <table>
        <thead><tr><th><%= t("directory.reports.index.col_name") %></th><th><%= t("directory.reports.index.col_kind") %></th></tr></thead>
        <tbody>
          <% @unmanaged_collections.each do |c| %>
            <tr>
              <td><%= link_to c.name, directory_collection_path(c.slug) %></td>
              <td><span is-="badge" variant-="<%= c.group? ? 'blue' : 'green' %>"><%= c.kind %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2); padding: 4px 0;"><%= t("directory.reports.index.none") %></span>
    <% end %>
  </details>

  <%# Orphan people %>
  <details<%= " open" if @orphan_people.any? %>>
    <summary style="cursor: pointer;"><b style="color: var(--foreground1);"><%= t("directory.reports.index.orphan_people") %></b> <span is-="badge" variant-="background2"><%= @orphan_people.size %></span></summary>
    <% if @orphan_people.any? %>
      <table>
        <thead><tr><th><%= t("directory.reports.index.col_name") %></th><th><%= t("directory.reports.index.col_email") %></th></tr></thead>
        <tbody>
          <% @orphan_people.each do |p| %>
            <tr>
              <td><%= link_to p.full_name, directory_person_path(p) %></td>
              <td style="color: var(--foreground2);"><%= p.primary_email %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2); padding: 4px 0;"><%= t("directory.reports.index.none") %></span>
    <% end %>
  </details>

  <%# Locked identities %>
  <details>
    <summary style="cursor: pointer;"><b style="color: var(--foreground1);"><%= t("directory.reports.index.locked_identities") %></b> <span is-="badge" variant-="background2"><%= @locked_people.size %></span></summary>
    <% if @locked_people.any? %>
      <table>
        <thead><tr><th><%= t("directory.reports.index.col_name") %></th><th><%= t("directory.reports.index.col_email") %></th></tr></thead>
        <tbody>
          <% @locked_people.each do |p| %>
            <tr>
              <td><%= link_to p.full_name, directory_person_path(p) %></td>
              <td style="color: var(--foreground2);"><%= p.primary_email %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2); padding: 4px 0;"><%= t("directory.reports.index.none") %></span>
    <% end %>
  </details>

  <%# Old memberships %>
  <details>
    <summary style="cursor: pointer;"><b style="color: var(--foreground1);"><%= t("directory.reports.index.old_memberships") %></b> <span is-="badge" variant-="background2"><%= @old_memberships.size %></span></summary>
    <% if @old_memberships.any? %>
      <table>
        <thead><tr><th><%= t("directory.reports.index.col_person") %></th><th><%= t("directory.reports.index.col_collection") %></th><th><%= t("directory.reports.index.col_created") %></th></tr></thead>
        <tbody>
          <% @old_memberships.each do |m| %>
            <tr>
              <td><%= link_to m.member_person.full_name, directory_person_path(m.member_person) %></td>
              <td><%= link_to m.collection.name, directory_collection_path(m.collection.slug) %></td>
              <td style="color: var(--foreground2);"><%= m.created_at.strftime("%Y-%m-%d") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2); padding: 4px 0;"><%= t("directory.reports.index.none") %></span>
    <% end %>
  </details>

  <div is-="separator"></div>
  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> <%= t("directory.layout.back") %>
    </row>
  </row>
</column>

<% content_for :title, t("directory.reports.index.title") %>

<div class="page-header">
  <h1><%= t("directory.reports.index.heading") %></h1>
  <div class="header-actions">
    <%= link_to t("directory.actions.back_to_directory"), directory_root_path, role: "button", class: "button-secondary" %>
  </div>
</div>

<div class="page-sections">
  <section class="section-card">
    <h3><%= t("directory.reports.index.empty_collections") %></h3>
    <% if @empty_collections.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.reports.index.col_name") %></th>
            <th><%= t("directory.reports.index.col_kind") %></th>
          </tr>
        </thead>
        <tbody>
          <% @empty_collections.each do |collection| %>
            <tr>
              <td><%= link_to collection.name, directory_collection_path(collection.slug) %></td>
              <td><span class="badge"><%= collection.kind %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><small><%= t("directory.reports.index.none") %></small></p>
    <% end %>
  </section>

  <section class="section-card">
    <h3><%= t("directory.reports.index.unmanaged_collections") %></h3>
    <% if @unmanaged_collections.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.reports.index.col_name") %></th>
            <th><%= t("directory.reports.index.col_kind") %></th>
          </tr>
        </thead>
        <tbody>
          <% @unmanaged_collections.each do |collection| %>
            <tr>
              <td><%= link_to collection.name, directory_collection_path(collection.slug) %></td>
              <td><span class="badge"><%= collection.kind %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><small><%= t("directory.reports.index.none") %></small></p>
    <% end %>
  </section>

  <section class="section-card">
    <h3><%= t("directory.reports.index.orphan_people") %></h3>
    <% if @orphan_people.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.reports.index.col_name") %></th>
            <th><%= t("directory.reports.index.col_email") %></th>
          </tr>
        </thead>
        <tbody>
          <% @orphan_people.each do |person| %>
            <tr>
              <td><%= link_to person.full_name, directory_person_path(person) %></td>
              <td><small><%= person.primary_email %></small></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><small><%= t("directory.reports.index.none") %></small></p>
    <% end %>
  </section>

  <section class="section-card">
    <h3><%= t("directory.reports.index.locked_identities") %></h3>
    <% if @locked_people.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.reports.index.col_name") %></th>
            <th><%= t("directory.reports.index.col_email") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @locked_people.each do |person| %>
            <tr>
              <td><%= link_to person.full_name, directory_person_path(person) %></td>
              <td><small><%= person.primary_email %></small></td>
              <td><span class="badge danger"><%= t("directory.badges.locked") %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><small><%= t("directory.reports.index.none") %></small></p>
    <% end %>
  </section>

  <section class="section-card">
    <h3><%= t("directory.reports.index.old_memberships") %></h3>
    <% if @old_memberships.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.reports.index.col_person") %></th>
            <th><%= t("directory.reports.index.col_collection") %></th>
            <th><%= t("directory.reports.index.col_created_at") %></th>
          </tr>
        </thead>
        <tbody>
          <% @old_memberships.each do |membership| %>
            <tr>
              <td><%= link_to membership.member_person.full_name, directory_person_path(membership.member_person) %></td>
              <td><%= link_to membership.collection.name, directory_collection_path(membership.collection.slug) %></td>
              <td><small><%= membership.created_at.strftime("%Y-%m-%d") %></small></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><small><%= t("directory.reports.index.none") %></small></p>
    <% end %>
  </section>

  <section class="section-card">
    <h3><%= t("directory.reports.index.expiring_memberships") %></h3>
    <% if @expiring_memberships.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.reports.index.col_person") %></th>
            <th><%= t("directory.reports.index.col_collection") %></th>
            <th><%= t("directory.reports.index.col_expires_at") %></th>
          </tr>
        </thead>
        <tbody>
          <% @expiring_memberships.each do |membership| %>
            <tr>
              <td><%= link_to membership.member_person.full_name, directory_person_path(membership.member_person) %></td>
              <td><%= link_to membership.collection.name, directory_collection_path(membership.collection.slug) %></td>
              <td><small><%= membership.expires_at.strftime("%Y-%m-%d") %></small></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p><small><%= t("directory.reports.index.none") %></small></p>
    <% end %>
  </section>
</div>

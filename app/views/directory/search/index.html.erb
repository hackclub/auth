<% content_for :title, "search" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>search</h2>
  </row>

  <div is-="separator"></div>

  <%= form_with url: directory_search_path, method: :get, local: true do %>
    <row gap-="1" align-="center">
      <span style="color: var(--foreground2);">⌕</span>
      <%= text_field_tag :q, params[:q], placeholder: "search people and collections…", autofocus: true, style: "flex: 1; border: none;" %>
      <button type="submit" size-="small">search</button>
    </row>
  <% end %>

  <% if params[:q].present? %>
    <div is-="separator"></div>

    <span style="color: var(--foreground2); font-style: italic;">people</span>

    <% if @people.any? %>
      <table>
        <thead>
          <tr>
            <th>name</th>
            <th>email</th>
          </tr>
        </thead>
        <tbody>
          <% @people.each do |person| %>
            <tr>
              <td><%= link_to person.full_name, directory_person_path(person) %></td>
              <td style="color: var(--foreground2);"><%= person.primary_email %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2);">no results</span>
    <% end %>

    <div is-="separator"></div>

    <span style="color: var(--foreground2); font-style: italic;">collections</span>

    <% if @collections.any? %>
      <table>
        <thead>
          <tr>
            <th>name</th>
            <th>kind</th>
          </tr>
        </thead>
        <tbody>
          <% @collections.each do |collection| %>
            <tr>
              <td><%= link_to collection.name, directory_collection_path(collection.slug) %></td>
              <td><span is-="badge" variant-="<%= collection.group? ? 'blue' : 'green' %>"><%= collection.kind %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2);">no results</span>
    <% end %>
  <% else %>
    <div is-="separator"></div>

    <column align-="center center" pad-="4 0">
      <span style="color: var(--foreground2);">enter a query to search people and collections</span>
    </column>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> back
    </row>
  </row>
</column>

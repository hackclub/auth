<% content_for :title, t("directory.search.title") %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <h2><%= t("directory.search.heading") %></h2>

  <form action="<%= directory_search_path %>" method="get">
    <row gap-="2" align-="center">
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="<%= t("directory.search.placeholder") %>" style="flex: 1;" />
      <button type="submit" size-="small"><%= t("directory.search.button") %></button>
    </row>
  </form>

  <div is-="separator"></div>

  <% if params[:q].present? %>
    <h3><%= t("directory.search.people_heading") %></h3>
    <% if @people.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.search.col_name") %></th>
            <th><%= t("directory.search.col_email") %></th>
          </tr>
        </thead>
        <tbody>
          <% @people.each do |person| %>
            <tr>
              <td><a href="<%= directory_person_path(person) %>" data-navigable-item><%= person.full_name %></a></td>
              <td style="color: var(--foreground2);"><%= person.primary_email %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2);"><%= t("directory.search.no_people") %></span>
    <% end %>

    <div is-="separator"></div>

    <h3><%= t("directory.search.collections_heading") %></h3>
    <% if @collections.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.search.col_name") %></th>
            <th><%= t("directory.search.col_kind") %></th>
          </tr>
        </thead>
        <tbody>
          <% @collections.each do |collection| %>
            <tr>
              <td>
                <a href="<%= directory_collection_path(collection.slug) %>" data-navigable-item><%= collection.name %></a>
              </td>
              <td>
                <span is-="badge" variant-="<%= collection.group? ? 'blue' : 'green' %>"><%= collection.kind %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <span style="color: var(--foreground2);"><%= t("directory.search.no_collections") %></span>
    <% end %>
  <% else %>
    <span style="color: var(--foreground2);"><%= t("directory.search.prompt") %></span>
  <% end %>
</column>

<% content_for :title, "activity" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>activity</h2>
    <row gap-="2" align-="center">
      <a href="<%= directory_root_path %>" style="color: var(--foreground2);">directory</a>
    </row>
  </row>

  <div is-="separator"></div>

  <% if @activities.any? %>
    <%= render "backend/shared/activity_log", activities: @activities %>
    <%= paginate @activities %>
  <% else %>
    <column align-="center center" pad-="4 0">
      <span style="color: var(--foreground2);">no activity</span>
    </column>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> back
    </row>
  </row>
</column>

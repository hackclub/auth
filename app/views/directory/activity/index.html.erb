<% content_for :title, t("directory.activity.index.title") %>

<div class="page-header">
  <h1><%= t("directory.activity.index.heading") %></h1>
  <div class="header-actions">
    <%= link_to t("directory.actions.back_to_directory"), directory_root_path, role: "button", class: "button-secondary" %>
  </div>
</div>

<div class="page-sections">
  <section class="section-card">
    <% if @activities.any? %>
      <%= render "backend/shared/activity_log", activities: @activities %>
      <%= paginate @activities %>
    <% else %>
      <div class="empty-state">
        <p><%= t("directory.activity.index.empty") %></p>
      </div>
    <% end %>
  </section>
</div>

<% content_for :title, t("directory.my_access.show.title") %>

<div class="page-header">
  <h1><%= t("directory.my_access.show.heading") %></h1>
</div>

<div class="page-sections">
  <% if @memberships.any? %>
    <% direct, via = @memberships.partition { |m| m[:direct] } %>

    <% if direct.any? %>
      <section class="section-card">
        <h3><%= t("directory.my_access.show.direct") %></h3>
        <table>
          <thead>
            <tr>
              <th><%= t("directory.my_access.show.col_collection") %></th>
              <th><%= t("directory.my_access.show.col_kind") %></th>
            </tr>
          </thead>
          <tbody>
            <% direct.each do |m| %>
              <tr>
                <td><%= link_to m[:collection].name, directory_collection_path(m[:collection].slug) %></td>
                <td><span class="badge"><%= m[:collection].kind %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>

    <% if via.any? %>
      <section class="section-card">
        <h3><%= t("directory.my_access.show.via") %></h3>
        <table>
          <thead>
            <tr>
              <th><%= t("directory.my_access.show.col_collection") %></th>
              <th><%= t("directory.my_access.show.col_kind") %></th>
              <th><%= t("directory.my_access.show.col_via") %></th>
            </tr>
          </thead>
          <tbody>
            <% via.each do |m| %>
              <tr>
                <td><%= link_to m[:collection].name, directory_collection_path(m[:collection].slug) %></td>
                <td><span class="badge"><%= m[:collection].kind %></span></td>
                <td>
                  <small><%= m[:via_path].map { |c| link_to(c.name, directory_collection_path(c.slug)) }.join(" → ").html_safe %></small>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    <% end %>
  <% else %>
    <div class="empty-state">
      <p><%= t("directory.my_access.show.no_memberships") %></p>
    </div>
  <% end %>
</div>

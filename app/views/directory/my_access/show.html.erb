<% content_for :title, "my access" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>my access</h2>
  </row>

  <div is-="separator"></div>

  <% if @memberships.any? %>
    <% direct, via = @memberships.partition { |m| m[:direct] } %>

    <% if direct.any? %>
      <span style="color: var(--foreground2); font-style: italic;">direct memberships</span>
      <table>
        <thead><tr><th>collection</th><th>kind</th></tr></thead>
        <tbody>
          <% direct.each do |m| %>
            <tr>
              <td><%= link_to m[:collection].name, directory_collection_path(m[:collection].slug) %></td>
              <td><span is-="badge" variant-="<%= m[:collection].group? ? 'blue' : 'green' %>"><%= m[:collection].kind %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

    <% if via.any? %>
      <% if direct.any? %><div is-="separator"></div><% end %>
      <span style="color: var(--foreground2); font-style: italic;">via nesting</span>
      <table>
        <thead><tr><th>collection</th><th>kind</th><th>via</th></tr></thead>
        <tbody>
          <% via.each do |m| %>
            <tr>
              <td><%= link_to m[:collection].name, directory_collection_path(m[:collection].slug) %></td>
              <td><span is-="badge" variant-="<%= m[:collection].group? ? 'blue' : 'green' %>"><%= m[:collection].kind %></span></td>
              <td style="color: var(--foreground2);">
                <% if m[:via_path].present? %>
                  <%= m[:via_path].map { |c| link_to(c.name, directory_collection_path(c.slug)) }.join(" → ").html_safe %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% else %>
    <span style="color: var(--foreground2);">you don't have any directory memberships yet.</span>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> back
    </row>
  </row>
</column>

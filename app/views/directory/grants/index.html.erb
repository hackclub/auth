<% content_for :title, t("directory.grants.index.title") %>

<div class="page-header">
  <h1><%= t("directory.grants.index.heading") %></h1>
  <div class="header-actions">
    <%= link_to t("directory.actions.back_to_directory"), directory_root_path, role: "button", class: "button-secondary" %>
  </div>
</div>

<div class="page-sections">
  <section class="section-card">
    <% if @grants.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.grants.index.col_grantee") %></th>
            <th><%= t("directory.grants.index.col_target") %></th>
            <th><%= t("directory.grants.index.col_permission") %></th>
            <th><%= t("directory.grants.index.col_recursive") %></th>
            <th><%= t("directory.grants.index.col_created_by") %></th>
            <th><%= t("directory.grants.index.col_created_at") %></th>
          </tr>
        </thead>
        <tbody>
          <% @grants.each do |grant| %>
            <tr>
              <td><%= link_to grant.grantee_group.name, directory_collection_path(grant.grantee_group.slug) %></td>
              <td><%= link_to grant.target_collection.name, directory_collection_path(grant.target_collection.slug) %></td>
              <td><%= grant.permission %></td>
              <td>
                <% if grant.recursive %>
                  <span class="badge"><%= t("directory.badges.recursive") %></span>
                <% end %>
              </td>
              <td><small><%= grant.created_by&.full_name %></small></td>
              <td><small><%= grant.created_at.strftime("%Y-%m-%d") %></small></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state">
        <p><%= t("directory.grants.index.empty") %></p>
      </div>
    <% end %>
  </section>
</div>

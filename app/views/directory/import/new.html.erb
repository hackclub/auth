<% content_for :title, t("directory.import.new.title") %>

<div class="page-header">
  <h1><%= t("directory.import.new.heading") %></h1>
  <div class="header-actions">
    <%= link_to t("directory.actions.back_to_directory"), directory_root_path, role: "button", class: "button-secondary" %>
  </div>
</div>

<div class="page-sections">
  <section class="section-card">
    <p><small><%= t("directory.import.new.description") %></small></p>

    <%= form_with url: directory_import_preview_path, method: :post, multipart: true, local: true do |f| %>
      <div>
        <%= f.label :csv_file, t("directory.import.new.file_label") %>
        <%= f.file_field :csv_file, accept: ".csv" %>
      </div>

      <hr>

      <div>
        <%= f.label :csv_text, t("directory.import.new.paste_label") %>
        <%= f.text_area :csv_text, rows: 8, placeholder: "email,collection_slug,expires_at\njane@example.com,engineering,\njohn@example.com,ops,2027-01-01", style: "font-family: monospace;" %>
      </div>

      <div class="form-actions">
        <%= f.submit t("directory.import.new.preview_button") %>
      </div>
    <% end %>
  </section>
</div>

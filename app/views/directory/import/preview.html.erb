<% content_for :title, "import preview" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>import preview</h2>
    <row gap-="2" align-="center">
      <a href="<%= directory_new_import_path %>" style="color: var(--foreground2);">back to import</a>
    </row>
  </row>

  <div is-="separator"></div>

  <% if @result.errors.any? %>
    <span style="color: var(--red); font-style: italic;">errors</span>

    <table>
      <thead>
        <tr>
          <th>row</th>
          <th>email</th>
          <th>error</th>
        </tr>
      </thead>
      <tbody>
        <% @result.errors.each do |error| %>
          <tr>
            <td><%= error[:row] %></td>
            <td><%= error[:email] %></td>
            <td><span is-="badge" variant-="red"><%= error[:message] %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div is-="separator"></div>
  <% end %>

  <% if @result.changes.any? %>
    <row align-="center between">
      <span style="color: var(--foreground2); font-style: italic;">changes</span>
      <span style="color: var(--foreground2);"><%= @result.created_count %> to add, <%= @result.skipped_count %> to skip</span>
    </row>

    <table>
      <thead>
        <tr>
          <th>email</th>
          <th>collection</th>
          <th>expires</th>
          <th>action</th>
        </tr>
      </thead>
      <tbody>
        <% @result.changes.each do |change| %>
          <tr>
            <td><%= change[:email] %></td>
            <td><%= change[:collection] %></td>
            <td style="color: var(--foreground2);"><%= change[:expires_at].presence || "—" %></td>
            <td>
              <% if change[:action] == "add" %>
                <span is-="badge" variant-="green">add</span>
              <% else %>
                <span is-="badge" variant-="background2">skip</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @result.errors.empty? %>
      <div is-="separator"></div>

      <%= form_with url: directory_import_path, method: :post, local: true do |f| %>
        <%= f.hidden_field :csv_text, value: @csv_string %>
        <row gap-="2" align-="center">
          <a href="<%= directory_new_import_path %>" style="color: var(--foreground2);">back</a>
          <button type="submit" size-="small">apply import</button>
        </row>
      <% end %>
    <% end %>
  <% else %>
    <% if @result.errors.empty? %>
      <column align-="center center" pad-="4 0">
        <span style="color: var(--foreground2);">no changes to apply</span>
      </column>
    <% end %>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> back
    </row>
  </row>
</column>

<% content_for :title, "people" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>people</h2>
  </row>

  <div is-="separator"></div>

  <%# Bring-in search %>
  <span style="color: var(--foreground2); font-style: italic;">bring someone in</span>
  <%= form_with url: directory_people_path, method: :get, local: true do |f| %>
    <row gap-="1" align-="center">
      <%= f.email_field :email, placeholder: "search by email…", value: params[:email], style: "flex: 1; border: none;" %>
      <button type="submit" size-="small">search</button>
    </row>
  <% end %>

  <% if @search_results.present? %>
    <table>
      <thead><tr><th>name</th><th>email</th><th></th></tr></thead>
      <tbody>
        <% @search_results.each do |identity| %>
          <tr>
            <td><%= identity.full_name %></td>
            <td style="color: var(--foreground2);"><%= identity.primary_email %></td>
            <td style="text-align: right;">
              <% if Directory::Person.exists?(identity: identity) %>
                <span is-="badge" variant-="background2">already in</span>
              <% else %>
                <%= form_with url: directory_people_path, method: :post, local: true do |f| %>
                  <%= f.hidden_field :identity_id, value: identity.id %>
                  <button type="submit" size-="small">bring in</button>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div is-="separator"></div>

  <%# All people %>
  <span style="color: var(--foreground2); font-style: italic;">all people</span>
  <% if @people.any? %>
    <table>
      <thead><tr><th>name</th><th>email</th><th>status</th></tr></thead>
      <tbody>
        <% @people.each do |person| %>
          <tr>
            <td><%= link_to person.full_name, directory_person_path(person) %></td>
            <td style="color: var(--foreground2);"><%= person.primary_email %></td>
            <td>
              <% if person.locked? %>
                <span is-="badge" variant-="red">locked</span>
              <% end %>
              <% if person.effective_memberships.empty? %>
                <span is-="badge" variant-="yellow">holds nothing</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <span style="color: var(--foreground2);">no people in the directory yet.</span>
  <% end %>

  <% if @holds_nothing.present? && @holds_nothing.any? %>
    <div is-="separator"></div>

    <span style="color: var(--foreground2); font-style: italic;">holds nothing</span>
    <table>
      <thead><tr><th>name</th><th>email</th><th></th></tr></thead>
      <tbody>
        <% @holds_nothing.each do |person| %>
          <tr>
            <td><%= link_to person.full_name, directory_person_path(person) %></td>
            <td style="color: var(--foreground2);"><%= person.primary_email %></td>
            <td style="text-align: right;">
              <%= button_to "remove", directory_person_path(person), method: :delete, data: { confirm: "remove #{person.full_name}?" }, style: "all:unset; color:var(--red); text-decoration:underline; cursor:pointer;" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> back
    </row>
  </row>
</column>

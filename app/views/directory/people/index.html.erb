<% content_for :title, t("directory.people.index.title") %>

<div class="page-header">
  <h1><%= t("directory.people.index.heading") %></h1>
</div>

<div class="page-sections">
  <section class="section-card">
    <h3><%= t("directory.people.index.bring_in") %></h3>
    <%= form_with url: directory_people_path, method: :get, local: true do |f| %>
      <div class="flex-row gap align-center">
        <%= f.email_field :email, placeholder: t("directory.people.index.email_placeholder"), style: "flex: 1;" %>
        <button type="submit"><%= t("directory.people.index.search") %></button>
      </div>
    <% end %>

    <% if @search_results.present? %>
      <hr>
      <% @search_results.each do |identity| %>
        <div class="flex-row gap align-center" style="justify-content: space-between; margin-bottom: 0.5rem;">
          <span><%= identity.full_name %> &lt;<%= identity.primary_email %>&gt;</span>
          <% if Directory::Person.exists?(identity: identity) %>
            <span class="badge"><%= t("directory.people.index.already_in") %></span>
          <% else %>
            <%= form_with url: directory_people_path, method: :post, local: true do |f| %>
              <%= f.hidden_field :identity_id, value: identity.id %>
              <button type="submit"><%= t("directory.people.index.bring_in_button") %></button>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="section-card">
    <% if @people.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.people.index.col_name") %></th>
            <th><%= t("directory.people.index.col_email") %></th>
            <th><%= t("directory.people.index.col_status") %></th>
          </tr>
        </thead>
        <tbody>
          <% @people.each do |person| %>
            <tr>
              <td><%= link_to person.full_name, directory_person_path(person) %></td>
              <td><small><%= person.primary_email %></small></td>
              <td>
                <% if person.locked? %>
                  <span class="badge danger"><%= t("directory.people.index.locked") %></span>
                <% end %>
                <% if person.effective_memberships.empty? %>
                  <span class="badge"><%= t("directory.people.index.holds_nothing") %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state">
        <p><%= t("directory.people.index.no_people") %></p>
      </div>
    <% end %>
  </section>

  <% if @holds_nothing.present? && @holds_nothing.any? %>
    <section class="section-card">
      <h3><%= t("directory.people.index.holds_nothing_heading") %></h3>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.people.index.col_name") %></th>
            <th><%= t("directory.people.index.col_email") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @holds_nothing.each do |person| %>
            <tr>
              <td><%= link_to person.full_name, directory_person_path(person) %></td>
              <td><small><%= person.primary_email %></small></td>
              <td>
                <%= button_to t("directory.people.index.remove"),
                      directory_person_path(person),
                      method: :delete,
                      class: "danger small-btn",
                      form: { onsubmit: "return confirm('#{j t("directory.people.index.remove_confirm", name: person.full_name)}')" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
</div>

<% content_for :title, "edit: #{@collection.name}" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>edit: <%= @collection.name %></h2>
  </row>

  <div is-="separator"></div>

  <%= form_with model: @collection, url: directory_collection_path(@collection.slug), method: :patch, local: true do |f| %>
    <column gap-="1" style="max-width: 600px;">
      <label style="color: var(--foreground2);">name</label>
      <%= f.text_field :name, required: true, style: "border: none;" %>

      <label style="color: var(--foreground2);">slug</label>
      <span><%= @collection.slug %></span>

      <label style="color: var(--foreground2);">kind</label>
      <span><span is-="badge" variant-="<%= @collection.group? ? 'blue' : 'green' %>"><%= @collection.kind %></span></span>

      <label style="color: var(--foreground2);">description</label>
      <%= f.text_area :description, rows: 3, style: "border: none;" %>

      <row gap-="1" align-="center">
        <%= f.check_box :protected %>
        <label style="color: var(--foreground2);">protected <span style="font-size: 0.85em;">(recursive grants can't reach this collection)</span></label>
      </row>

      <div is-="separator"></div>

      <row gap-="2" align-="center">
        <button type="submit" size-="small">save changes</button>
        <a href="<%= directory_collection_path(@collection.slug) %>" style="color: var(--foreground2);">cancel</a>
      </row>
    </column>
  <% end %>
</column>

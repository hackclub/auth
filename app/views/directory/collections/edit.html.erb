<% content_for :title, t("directory.collections.edit.title") %>

<div class="page-header">
  <h1><%= t("directory.collections.edit.heading", name: @collection.name) %></h1>
</div>

<div class="page-sections">
  <section class="section-card" style="max-width: 700px;">
    <%= form_with model: @collection, url: directory_collection_path(@collection.slug), method: :patch, local: true do |f| %>
      <div>
        <%= f.label :name, t("directory.collections.form.name") %>
        <%= f.text_field :name, required: true %>
      </div>

      <div>
        <label><%= t("directory.collections.form.slug") %></label>
        <small><%= @collection.slug %></small>
      </div>

      <div>
        <label><%= t("directory.collections.form.kind") %></label>
        <span class="badge"><%= @collection.kind %></span>
      </div>

      <div>
        <%= f.label :description, t("directory.collections.form.description") %>
        <%= f.text_area :description, rows: 3 %>
      </div>

      <div>
        <label>
          <%= f.check_box :protected %>
          <%= t("directory.collections.form.protected") %>
        </label>
      </div>

      <div class="form-actions">
        <%= f.submit t("directory.collections.edit.submit") %>
        <%= link_to t("directory.actions.cancel"), directory_collection_path(@collection.slug), class: "button-secondary" %>
      </div>
    <% end %>
  </section>
</div>

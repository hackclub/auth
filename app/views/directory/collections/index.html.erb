<% content_for :title, "Directory" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>directory</h2>
    <row gap-="2" align-="center">
      <% if directory_admin? %>
        <a href="<%= directory_reports_path %>" style="color: var(--foreground2);">reports</a>
        <a href="<%= directory_activity_path %>" style="color: var(--foreground2);">activity</a>
        <a href="<%= directory_health_path %>" style="color: var(--foreground2);">health</a>
        <a href="<%= directory_new_import_path %>" style="color: var(--foreground2);">import</a>
        <a href="<%= new_directory_collection_path %>"><button size-="small">+ new collection</button></a>
      <% end %>
    </row>
  </row>

  <div is-="separator"></div>

  <%= form_with url: directory_search_path, method: :get, local: true do %>
    <row gap-="1" align-="center">
      <span style="color: var(--foreground2);">⌕</span>
      <%= text_field_tag :q, params[:q], placeholder: "search people and collections…", autofocus: true, style: "flex: 1; border: none;" %>
      <button type="submit" size-="small">search</button>
    </row>
  <% end %>

  <div is-="separator"></div>

  <% if @collections.any? %>
    <table>
      <thead>
        <tr>
          <th>name</th>
          <th>kind</th>
          <th style="text-align: right;">direct</th>
          <th style="text-align: right;">total</th>
          <th style="text-align: right;">you can</th>
        </tr>
      </thead>
      <tbody>
        <% @collections.each do |collection| %>
          <tr>
            <td>
              <%= link_to collection.name, directory_collection_path(collection.slug) %>
              <% if collection.protected %>
                <span is-="badge" variant-="yellow">protected</span>
              <% end %>
            </td>
            <td>
              <span is-="badge" variant-="<%= collection.group? ? 'blue' : 'green' %>"><%= collection.kind %></span>
            </td>
            <td style="text-align: right;"><%= collection.direct_member_count %></td>
            <td style="text-align: right;"><%= collection.effective_member_count %></td>
            <td style="text-align: right; color: var(--foreground2);">
              <% perms = [] %>
              <% perms << "view" if pundit_user.can?(:view, collection) %>
              <% perms << "manage" if pundit_user.can?(:manage_members, collection) %>
              <% perms << "expose" if pundit_user.can?(:expose, collection) %>
              <%= perms.join(", ") %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <column align-="center center" pad-="4 0">
      <span style="color: var(--foreground2);">no collections yet. create one to get started.</span>
    </column>
  <% end %>
</column>

<% content_for :title, t("directory.collections.index.title") %>
<% groups = @collections.select(&:group?) %>
<% entitlements = @collections.select(&:entitlement?) %>
<div class="dir-page">
  <div class="dir-page-header">
    <div class="dir-title-row">
      <div class="dir-title">
        <h2><%= groups.size + entitlements.size %> collections</h2>
      </div>
      <row gap-="1" align-="center">
        <% if directory_admin? %>
          <a href="<%= new_directory_collection_path %>" is-="button" size-="small" variant-="green"><%= t("directory.collections.index.new_button") %></a>
        <% end %>
      </row>
    </div>
  </div>

  <%# Groups %>
  <div class="dir-section" data-accent="blue">
    <div class="dir-section-header">
      <span><%= t("directory.collections.index.groups") %> <span is-="badge" variant-="blue"><%= groups.size %></span></span>
    </div>
    <% if groups.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.collections.index.col_name") %></th>
            <th style="text-align: right;">members</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% groups.each do |g| %>
            <tr>
              <td>
                <%= link_to g.name, directory_collection_path(g.slug) %>
                <% if g.protected %>
                  <span is-="badge" variant-="yellow"><%= t("directory.badges.protected") %></span>
                <% end %>
              </td>
              <td style="text-align: right;">
                <%= g.direct_member_count %><% if g.effective_member_count != g.direct_member_count %> <span style="color: var(--foreground2);">(+<%= g.effective_member_count - g.direct_member_count %> nested)</span><% end %>
              </td>
              <td style="text-align: right;">
                <% if pundit_user.can?(:manage_members, g) %>
                  <span is-="badge" variant-="blue">manage</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="dir-section-empty"><%= t("directory.collections.index.no_groups") %></div>
    <% end %>
  </div>

  <%# Entitlements %>
  <div class="dir-section" data-accent="green">
    <div class="dir-section-header">
      <span><%= t("directory.collections.index.entitlements") %> <span is-="badge" variant-="green"><%= entitlements.size %></span></span>
    </div>
    <% if entitlements.any? %>
      <table>
        <thead>
          <tr>
            <th><%= t("directory.collections.index.col_name") %></th>
            <th style="text-align: right;">members</th>
            <th style="text-align: right;">apps</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% entitlements.each do |e| %>
            <tr>
              <td>
                <%= link_to e.name, directory_collection_path(e.slug) %>
                <% if e.protected %>
                  <span is-="badge" variant-="yellow"><%= t("directory.badges.protected") %></span>
                <% end %>
              </td>
              <td style="text-align: right;">
                <%= e.direct_member_count %><% if e.effective_member_count != e.direct_member_count %> <span style="color: var(--foreground2);">(+<%= e.effective_member_count - e.direct_member_count %> nested)</span><% end %>
              </td>
              <td style="text-align: right;"><%= e.exposure_count %></td>
              <td style="text-align: right;">
                <% if pundit_user.can?(:manage_members, e) %>
                  <span is-="badge" variant-="blue">manage</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="dir-section-empty"><%= t("directory.collections.index.no_entitlements") %></div>
    <% end %>
  </div>

  <% unless @collections.any? %>
    <div class="dir-empty">
      <span class="dir-empty-icon">⌂</span>
      <span><%= t("directory.collections.index.empty_message") %></span>
      <span style="font-size: 0.75em; opacity: 0.4;">hduc</span>
    </div>
  <% end %>

  <div class="dir-keyhints">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">⌘K</span> command palette
    </row>
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">/</span> search
    </row>
  </div>
</div>
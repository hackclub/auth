<% content_for :title, t("directory.collections.index.title") %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2><%= t("directory.collections.index.heading") %></h2>
    <row gap-="2" align-="center">
      <% if directory_admin? %>
        <a href="<%= directory_reports_path %>"><%= t("directory.nav.reports") %></a>
        <a href="<%= directory_activity_path %>"><%= t("directory.nav.activity") %></a>
        <a href="<%= directory_health_path %>"><%= t("directory.nav.health") %></a>
        <a href="<%= new_directory_import_path %>"><%= t("directory.nav.import") %></a>
        <a href="<%= new_directory_collection_path %>"><button size-="small"><%= t("directory.collections.index.new_collection") %></button></a>
      <% else %>
        <a href="<%= directory_activity_path %>"><%= t("directory.nav.activity") %></a>
      <% end %>
    </row>
  </row>

  <div is-="separator"></div>

  <form action="<%= directory_search_path %>" method="get">
    <row gap-="2" align-="center">
      <input type="text" name="q" placeholder="<%= t("directory.search.placeholder") %>" style="flex: 1;" />
      <button type="submit" size-="small"><%= t("directory.search.button") %></button>
    </row>
  </form>

  <div is-="separator"></div>

  <% if @collections.any? %>
    <table>
      <thead>
        <tr>
          <th><%= t("directory.collections.index.col_name") %></th>
          <th><%= t("directory.collections.index.col_kind") %></th>
          <th><%= t("directory.collections.index.col_direct") %></th>
          <th><%= t("directory.collections.index.col_effective") %></th>
          <th><%= t("directory.collections.index.col_access") %></th>
        </tr>
      </thead>
      <tbody>
        <% @collections.each do |collection| %>
          <tr>
            <td>
              <a href="<%= directory_collection_path(collection.slug) %>" data-navigable-item>
                <%= collection.name %>
              </a>
              <% if collection.protected %>
                <span is-="badge" variant-="yellow"><%= t("directory.badges.protected") %></span>
              <% end %>
            </td>
            <td>
              <span is-="badge" variant-="<%= collection.group? ? 'blue' : 'green' %>"><%= collection.kind %></span>
            </td>
            <td><%= collection.direct_member_count %></td>
            <td><%= collection.effective_member_count %></td>
            <td style="color: var(--foreground2);">
              <% permissions = [] %>
              <% permissions << "view" if pundit_user.can?(:view, collection) %>
              <% permissions << "manage members" if pundit_user.can?(:manage_members, collection) %>
              <% permissions << "expose" if pundit_user.can?(:expose, collection) %>
              <% if permissions.any? %>
                <%= permissions.join(", ") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <span style="color: var(--foreground2);"><%= t("directory.collections.index.empty") %></span>
  <% end %>
</column>

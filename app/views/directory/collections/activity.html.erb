<% content_for :title, t("directory.collections.activity.title", name: @collection.name) %>

<div class="page-header">
  <h1><%= t("directory.collections.activity.heading", name: @collection.name) %></h1>
  <div class="header-actions">
    <%= link_to t("directory.actions.back_to_collection"), directory_collection_path(@collection.slug) %>
  </div>
</div>

<div class="page-sections">
  <section class="section-card">
    <% if @activities.any? %>
      <%= render "backend/shared/activity_log", activities: @activities %>
      <%= paginate @activities %>
    <% else %>
      <div class="empty-state">
        <p><%= t("directory.collections.activity.empty") %></p>
      </div>
    <% end %>
  </section>
</div>

<% content_for :title, "activity: #{@collection.name}" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>activity: <%= @collection.name %></h2>
    <a href="<%= directory_collection_path(@collection.slug) %>" style="color: var(--foreground2);">← back to collection</a>
  </row>

  <div is-="separator"></div>

  <% if @activities.any? %>
    <%= render "backend/shared/activity_log", activities: @activities %>
    <%= paginate @activities %>
  <% else %>
    <span style="color: var(--foreground2);">no activity recorded.</span>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> back
    </row>
  </row>
</column>

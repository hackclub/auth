<% content_for :title, t("directory.collections.activity.title", name: @collection.name) %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2><%= t("directory.collections.activity.heading") %>: <%= @collection.name %></h2>
    <a href="<%= directory_collection_path(@collection.slug) %>" style="color: var(--foreground2);"><%= t("directory.collections.activity.back_to_collection") %></a>
  </row>

  <div is-="separator"></div>

  <% if @activities.any? %>
    <%= render "backend/shared/activity_log", activities: @activities %>
    <%= paginate @activities %>
  <% else %>
    <span style="color: var(--foreground2);"><%= t("directory.collections.activity.empty") %></span>
  <% end %>

  <div is-="separator"></div>

  <row gap-="2" align-="center" style="color: var(--foreground2);">
    <row gap-="1" align-="center">
      <span is-="badge" variant-="background2">Bksp</span> <%= t("directory.layout.back") %>
    </row>
  </row>
</column>
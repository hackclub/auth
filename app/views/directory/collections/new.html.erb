<% content_for :title, "new collection" %>
<column pad-="2 1" style="max-width: 120ch; margin: 0 auto; width: 100%;">
  <row align-="center between">
    <h2>new collection</h2>
  </row>

  <div is-="separator"></div>

  <%= form_with model: @collection, url: directory_collections_path, method: :post, local: true do |f| %>
    <column gap-="1" style="max-width: 600px;">
      <label style="color: var(--foreground2);">name</label>
      <%= f.text_field :name, required: true, placeholder: "e.g. fulltimers", style: "border: none;" %>

      <label style="color: var(--foreground2);">slug</label>
      <%= f.text_field :slug, required: true, placeholder: "e.g. fulltimers", style: "border: none;" %>
      <span style="color: var(--foreground2); font-size: 0.85em;">url-safe identifier. can't be changed after creation.</span>

      <label style="color: var(--foreground2);">kind</label>
      <row gap-="2" align-="center">
        <label><%= f.radio_button :kind, "group" %> group</label>
        <label><%= f.radio_button :kind, "entitlement" %> entitlement</label>
      </row>

      <label style="color: var(--foreground2);">description</label>
      <%= f.text_area :description, rows: 3, placeholder: "what is this collection for?", style: "border: none;" %>

      <row gap-="1" align-="center">
        <%= f.check_box :protected %>
        <label style="color: var(--foreground2);">protected <span style="font-size: 0.85em;">(recursive grants can't reach this collection)</span></label>
      </row>

      <div is-="separator"></div>

      <row gap-="2" align-="center">
        <button type="submit" size-="small">create collection</button>
        <a href="<%= directory_root_path %>" style="color: var(--foreground2);">cancel</a>
      </row>
    </column>
  <% end %>
</column>

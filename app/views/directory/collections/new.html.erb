<% content_for :title, "New Collection" %>

<div class="page-header">
  <h1>New Collection</h1>
</div>

<div class="page-sections">
  <%= form_with model: @collection, url: directory_collections_path, method: :post, local: true do |f| %>
    <section class="section-card">
      <div class="field-group">
        <%= f.label :name, "Name" %>
        <%= f.text_field :name, required: true, placeholder: "e.g. Fulltimers" %>
      </div>

      <div class="field-group">
        <%= f.label :slug, "Slug" %>
        <%= f.text_field :slug, required: true, placeholder: "e.g. fulltimers" %>
        <small style="color: var(--pico-muted-color);">URL-safe identifier. Can't be changed after creation.</small>
      </div>

      <fieldset style="border: none; padding: 0; margin-bottom: 1.25rem;">
        <legend style="font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem;">Kind</legend>
        <label class="checkbox-label">
          <%= f.radio_button :kind, "group" %>
          <div>
            <strong>Group</strong>
            <small style="display: block; color: var(--pico-muted-color);">A collection of people. Can be nested into other groups or entitlements.</small>
          </div>
        </label>
        <label class="checkbox-label">
          <%= f.radio_button :kind, "entitlement" %>
          <div>
            <strong>Entitlement</strong>
            <small style="display: block; color: var(--pico-muted-color);">Represents access. Can contain groups and people but can't be nested further.</small>
          </div>
        </label>
      </fieldset>

      <div class="field-group">
        <%= f.label :description, "Description" %>
        <%= f.text_area :description, rows: 3, placeholder: "What is this collection for?" %>
      </div>

      <label class="checkbox-label">
        <%= f.check_box :protected %>
        <div>
          <strong>Protected</strong>
          <small style="display: block; color: var(--pico-muted-color);">Recursive grants can't reach this collection. Only direct grants apply.</small>
        </div>
      </label>
    </section>

    <div class="form-actions">
      <%= f.submit "Create Collection" %>
      <%= link_to "Cancel", directory_root_path, class: "button-secondary" %>
    </div>
  <% end %>
</div>

<% content_for :title, t("directory.collections.new.title") %>

<div class="page-header">
  <h1><%= t("directory.collections.new.heading") %></h1>
</div>

<div class="page-sections">
  <section class="section-card" style="max-width: 700px;">
    <%= form_with model: @collection, url: directory_collections_path, method: :post, local: true do |f| %>
      <div>
        <%= f.label :name, t("directory.collections.form.name") %>
        <%= f.text_field :name, required: true %>
      </div>

      <div>
        <%= f.label :slug, t("directory.collections.form.slug") %>
        <%= f.text_field :slug, required: true %>
      </div>

      <fieldset>
        <legend><%= t("directory.collections.form.kind") %></legend>
        <label>
          <%= f.radio_button :kind, "group" %>
          <%= t("directory.collections.form.kind_group") %>
        </label>
        <label>
          <%= f.radio_button :kind, "entitlement" %>
          <%= t("directory.collections.form.kind_entitlement") %>
        </label>
      </fieldset>

      <div>
        <%= f.label :description, t("directory.collections.form.description") %>
        <%= f.text_area :description, rows: 3 %>
      </div>

      <div>
        <label>
          <%= f.check_box :protected %>
          <%= t("directory.collections.form.protected") %>
        </label>
      </div>

      <div class="form-actions">
        <%= f.submit t("directory.collections.new.submit") %>
        <%= link_to t("directory.actions.cancel"), directory_root_path, class: "button-secondary" %>
      </div>
    <% end %>
  </section>
</div>
